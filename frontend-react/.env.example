# ============================================================
# Nexora AI — Frontend Environment Variables
# Copy to .env (inside frontend-react/) and fill in values.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY here — it's backend-only.
# ============================================================

# Supabase public credentials (safe for frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API base URL
VITE_API_URL=http://localhost:8000
