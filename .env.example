# ============================================================
# Nexora AI — Backend Environment Variables
# Copy to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# ---- LLM Providers ----------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GOOGLE_API_KEY=your-google-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here        # optional

# ---- Tavily Web Search ------------------------------------
TAVILY_API_KEY=your-tavily-api-key-here

# ---- Supabase (Auth & Persistent Chat) --------------------
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Get from: Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ---- Frontend URL (for CORS & email redirect links) -------
FRONTEND_URL=http://localhost:5173

# ---- App Config -------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
